# Assessment Portal - Environment Configuration Template
# Copy this file to .env before starting in production

# Host and Port binding
ASSESSMENT_HOST=0.0.0.0
ASSESSMENT_PORT=8000

# Security (Set to 1 when serving over HTTPS / SSL behind reverse proxy)
ASSESSMENT_COOKIE_SECURE=1

# Session Durations
ASSESSMENT_SESSION_HOURS=12
ASSESSMENT_SESSION_IDLE_MINUTES=30

# Initial Bootstrap Admin (optional - create_admin.py can also be used)
ASSESSMENT_BOOTSTRAP_ADMIN=admin@mavrista.com
ASSESSMENT_BOOTSTRAP_PASSWORD=ChangeMeStrongPassword123!
ASSESSMENT_BOOTSTRAP_NAME=Portal Administrator

# Google Sheets Real-Time Sync Webhook (Apps Script Web App URL)
# ASSESSMENT_SHEETS_WEBHOOK=https://script.google.com/macros/s/AKfycbx.../exec

# Automated Data Retention & Cleanup (days before purging expired records, default: 90)
ASSESSMENT_RETENTION_DAYS=90

# Runner Configuration:
# - assessment-runner:local (Docker runner image)
# - Set ASSESSMENT_REQUIRE_DOCKER=1 if Docker container isolation is strictly mandatory
ASSESSMENT_RUNNER_IMAGE=assessment-runner:local
ASSESSMENT_REQUIRE_DOCKER=0

